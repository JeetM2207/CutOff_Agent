MODE=fake                         # fake | real
DEMO_MODE=0                       # 1 shows chaos panel + demo endpoints

LLM_PROVIDER=anthropic            # anthropic | openrouter | gemini
ANTHROPIC_API_KEY=
# Used only when LLM_PROVIDER=openrouter. Get a key at https://openrouter.ai/keys.
# Free tier is capped at 50 req/day ($0 accounts) or 1000 req/day ($10+ ever
# added) across ALL free models combined — see openrouter.ai/docs/api-reference/limits.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Used only when LLM_PROVIDER=gemini. Get a free key (no card) at
# https://aistudio.google.com/apikey. Free tier is per-model (not shared
# across models like OpenRouter's), generally 250-1500 req/day depending on
# the model — meaningfully more generous than OpenRouter's $0 tier.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# claude-sonnet-5 is an Anthropic-direct model id; it will 404 on OpenRouter
# or Gemini. Set LLM_MODEL to match whichever LLM_PROVIDER you're using:
#   openrouter -> a free, tool-calling-capable slug, e.g. liquid/lfm-2.5-2.6b:free
#     (verified live against openrouter.ai/api/v1/models on 2026-09-11 — re-check
#     if this ever goes stale; free-tier models can be rate-limited or reasoning-
#     heavy enough to never reach a tool call within a normal token budget)
#   gemini -> e.g. gemini-3.8-flash (verified current as of 2026-09-11)
LLM_MODEL=claude-sonnet-5         # verify current model IDs at docs.claude.com
LLM_MODEL_FAST=claude-haiku-4-5-20251001
TIMEZONE=Asia/Kolkata
DB_PATH=cutoff.db
POLL_INTERVAL_SECONDS=15

GOOGLE_CLIENT_SECRET_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
SHEET_ID=
CALENDAR_ID=primary
EXAM_CALENDAR_ID=                 # optional separate calendar with exam timetable
RESUME_FOLDER_ID=

# Optional: dynamic, JD-tailored resume generation (Section 6.4 extension).
# MASTER_PROFILE_PATH points at a local YAML file (see
# config/master_profile.example.yaml for the schema) listing your education,
# skills, projects, experience, links (GitHub/LinkedIn/etc.), and
# achievements -- never uploaded anywhere, edited by hand. Missing/empty file
# disables the feature and falls back to the static resume_*.pdf matching
# that already exists. Per drive, you choose over Telegram whether to use
# your resume on file or have one generated -- nothing is generated silently.
# Generated PDFs are written to GENERATED_RESUME_DIR and served by this app's
# own dashboard server (no Drive *write* scope needed) at PUBLIC_BASE_URL --
# set this to a real reachable URL (e.g. an ngrok tunnel) if you want the
# generated-resume link to work from a recruiter's Google Form, not just
# your own machine.
MASTER_PROFILE_PATH=config/master_profile.yaml
GENERATED_RESUME_DIR=generated_resumes
PUBLIC_BASE_URL=http://127.0.0.1:8000

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: point real adapters at Arga twins if you get access (check Arga docs for exact setup)
GMAIL_API_BASE_URL=
SHEETS_API_BASE_URL=
CALENDAR_API_BASE_URL=
DRIVE_API_BASE_URL=
